# SplitBill Production Backend Environment Configuration
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
DOCS_ENABLED=false

# Google Gemini API Key (Required for AI Receipt OCR)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (Comma-separated production domains)
CORS_ORIGINS=https://splitbill.vercel.app,https://your-custom-domain.com
